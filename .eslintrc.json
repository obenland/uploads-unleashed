{
	"extends": [ "plugin:@wordpress/eslint-plugin/recommended" ],
	"env": {
		"browser": true
	},
	"rules": {
		"import/no-unresolved": [
			"error",
			{
				"ignore": [ "^@uploads-unleashed/" ]
			}
		]
	},
	"overrides": [
		{
			"files": [ "tests/js/**/*.js" ],
			"env": {
				"jest": true
			}
		}
	]
}
