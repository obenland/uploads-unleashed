{
	"name": "resumable-uploads",
	"version": "0.1.0",
	"description": "TUS protocol support for resumable media uploads in WordPress",
	"author": "Konstantin Obenland",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"tus",
		"resumable",
		"upload",
		"media"
	],
	"homepage": "https://github.com/obenland/resumable-uploads",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/obenland/resumable-uploads.git"
	},
	"bugs": {
		"url": "https://github.com/obenland/resumable-uploads/issues"
	},
	"dependencies": {
		"tus-js-client": "^4.3.1"
	},
	"devDependencies": {
		"@wordpress/env": "^10.38.0",
		"@wordpress/i18n": "^5.15.0",
		"@wordpress/scripts": "^31.3.0"
	},
	"scripts": {
		"build": "wp-scripts build",
		"start:js": "wp-scripts start",
		"format": "wp-scripts format",
		"wp-env": "wp-env",
		"start": "wp-env start",
		"stop": "wp-env stop",
		"test": "wp-env run tests-cli --env-cwd=\"wp-content/plugins/resumable-uploads\" vendor/bin/phpunit",
		"test:js": "wp-scripts test-unit-js",
		"test:js:watch": "wp-scripts test-unit-js --watch",
		"destroy": "wp-env destroy",
		"cli": "wp-env run cli",
		"lint": "npm run lint:php && npm run lint:js && npm run lint:pkg-json",
		"lint:fix": "npm run lint:php:fix && npm run lint:js:fix",
		"lint:php": "composer lint",
		"lint:php:fix": "composer lint:fix",
		"lint:js": "wp-scripts lint-js",
		"lint:js:fix": "wp-scripts lint-js --fix",
		"lint:pkg-json": "wp-scripts lint-pkg-json"
	}
}
