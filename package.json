{
	"name": "uploads-unleashed",
	"version": "1.1.0",
	"description": "Upload large files to WordPress without hitting size limits or losing progress when your connection drops.",
	"author": "Konstantin Obenland",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"tus",
		"resumable",
		"upload",
		"media"
	],
	"homepage": "https://github.com/obenland/uploads-unleashed",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/obenland/uploads-unleashed.git"
	},
	"bugs": {
		"url": "https://github.com/obenland/uploads-unleashed/issues"
	},
	"dependencies": {
		"tus-js-client": "^4.3.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.0",
		"@wordpress/a11y": "^4.50.0",
		"@wordpress/api-fetch": "^7.51.0",
		"@wordpress/data": "^10.50.0",
		"@wordpress/env": "^11.11.0",
		"@wordpress/hooks": "^4.51.0",
		"@wordpress/i18n": "^6.22.0",
		"@wordpress/notices": "^5.52.0",
		"@wordpress/scripts": "^34.0.0"
	},
	"scripts": {
		"build": "wp-scripts build && npm run build:vendor",
		"build:vendor": "npx terser src/vendor/tus.js -o build/tus.min.js --compress --mangle",
		"dev": "wp-scripts start",
		"format": "wp-scripts format",
		"wp-env": "wp-env",
		"start": "wp-env start",
		"start:tests": "wp-env start --config .wp-env.tests.json",
		"stop": "wp-env stop",
		"stop:tests": "wp-env stop --config .wp-env.tests.json",
		"destroy:tests": "wp-env destroy --config .wp-env.tests.json",
		"test": "wp-env run cli --config .wp-env.tests.json --env-cwd=\"wp-content/plugins/uploads-unleashed\" vendor/bin/phpunit",
		"test:coverage": "wp-env run cli --config .wp-env.tests.json --env-cwd=\"wp-content/plugins/uploads-unleashed\" vendor/bin/phpunit --coverage-html coverage",
		"test:coverage:text": "wp-env run cli --config .wp-env.tests.json --env-cwd=\"wp-content/plugins/uploads-unleashed\" vendor/bin/phpunit --coverage-text",
		"test:js": "wp-scripts test-unit-js",
		"test:js:coverage": "wp-scripts test-unit-js --coverage --coverageDirectory=coverage/js",
		"test:js:watch": "wp-scripts test-unit-js --watch",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:install": "playwright install --with-deps chromium",
		"destroy": "wp-env destroy",
		"cli": "wp-env run cli",
		"lint": "npm run lint:php && npm run lint:js && npm run lint:pkg-json",
		"lint:fix": "npm run lint:php:fix && npm run lint:js:fix",
		"lint:php": "composer lint",
		"lint:php:fix": "composer lint:fix",
		"lint:js": "wp-scripts lint-js",
		"lint:js:fix": "wp-scripts lint-js --fix",
		"lint:pkg-json": "wp-scripts lint-pkg-json"
	}
}
